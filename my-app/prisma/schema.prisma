generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  relationMode = "prisma"
}

model User {
  id          Int       @id @default(autoincrement())
  first_name  String
  last_name   String
  username    String    @unique
  password    String
  email       String    @unique
  created_at  DateTime  @default(now())
  reviews     Review[]
}

model Review {
  id          Int       @id @default(autoincrement())
  user_id     Int
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  film_id     Int
  content     String
  rating      Float
  created_at  DateTime  @default(now())

  @@index([user_id])
}